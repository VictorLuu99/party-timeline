---
import '~/styles/global.css';
import ParallaxSparkles from '~/components/ParallaxSparkles.tsx';
interface Props { title?: string; description?: string }
const {
  title = 'Lịch Nhậu Huyền Thoại',
  description = 'Bộ sưu tập lịch nhậu huyền thoại của Victor Luu — bia, rượu, anh em, kỉ niệm. Uống có trách nhiệm. Nhậu nhiệt tình – sống hết mình!',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImage = new URL('/og.jpg', Astro.site ?? Astro.url.origin).toString();
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/bebas-neue.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/pacifico.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Lịch Nhậu Huyền Thoại" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Lịch Nhậu Huyền Thoại — Uống có trách nhiệm, không say không về!" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0518" />
  </head>
  <body class="font-body antialiased overflow-x-hidden">
    <ParallaxSparkles client:load count={80} />
    <slot />
  </body>
</html>
